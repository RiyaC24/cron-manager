# Port the dashboard and API listen on
PORT=3000

# Path to the SQLite database file
DB_PATH=./data/cron-manager.db

# Optional: comma-separated webhook URL(s) to notify on job failure
# Each URL receives a POST with JSON: { jobId, jobName, error, timestamp }
FAILURE_WEBHOOK_URLS=

# Optional: basic auth for the dashboard/API (leave blank to disable)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
